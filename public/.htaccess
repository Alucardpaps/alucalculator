# AluCalc OS v5.0 — Production Server Configuration
# Optimized for Next.js Static Export with trailingSlash: true

# 1. Base Resolution
Options -Indexes -MultiViews
DirectoryIndex index.html

RewriteEngine On

# 2. Canonical Redirect: non-www to www
RewriteCond %{HTTP_HOST} ^alucalculator\.com [NC]
RewriteRule ^(.*)$ https://www.alucalculator.com/$1 [L,R=301]

# 2b. Legacy /calculators/* → live module routes (301)
RewriteRule ^calculators/bearing-life/?$ /bearings/ [L,R=301]
RewriteRule ^calculators/bearing-life-calc/?$ /bearings/ [L,R=301]
RewriteRule ^calculators/vdi2230/?$ /bolt-torque/ [L,R=301]
RewriteRule ^calculators/bolt-torque-calc/?$ /bolt-torque/ [L,R=301]
RewriteRule ^calculators/beam-deflection-calc/?$ /beam-deflection/ [L,R=301]
RewriteRule ^calculators/gear-ratio-calc/?$ /gears/ [L,R=301]
RewriteRule ^calculators/shaft-diameter-calc/?$ /strength/ [L,R=301]
RewriteRule ^calculators/tolerance-stackup/?$ /fits/ [L,R=301]
RewriteRule ^calculators/fits-tolerances/?$ /fits/ [L,R=301]
RewriteRule ^calculators/machine-assembly/?$ /workspace/ [L,R=301]
RewriteRule ^calculators/([^/]+)/?$ /$1/ [L,R=301]

# 3. Production Security Headers
Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://cdn.jsdelivr.net https://pagead2.googlesyndication.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://*; connect-src 'self' https://*;"
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
Header set X-Content-Type-Options "nosniff"
Header set X-Frame-Options "SAMEORIGIN"
Header set X-XSS-Protection "1; mode=block"
Header set Referrer-Policy "strict-origin-when-cross-origin"

# 4. Physical File Protection
# If it is a real file, just serve it
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# 5. Next.js Static Routing for Directories
# Ensure folder/ correctly resolves to folder/index.html
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)$ $1/index.html [L]

# 6. Fallback for Clean URLs
# If file.html exists but was called as /file
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ $1.html [L]

# 7. Error Handling
ErrorDocument 404 /404.html

