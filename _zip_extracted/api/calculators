":"z1","formula":"max(floor(60000 / (pitch * n1)), 14)","description":"Driver pulley teeth (min 14)","latex":"z_1 = \\max\\left(\\lfloor\\frac{60000}{p \\times n_1}\\rfloor, 14\\right)"},{"id":"z2","formula":"round(z1 * i)","description":"Driven pulley teeth","latex":"z_2 = z_1 \\times i"},{"id":"d1","formula":"(z1 * pitch) / 3.14159","description":"Driver pulley pitch diameter","latex":"d_1 = \\frac{z_1 \\times p}{\\pi}"},{"id":"d2","formula":"(z2 * pitch) / 3.14159","description":"Driven pulley pitch diameter","latex":"d_2 = \\frac{z_2 \\times p}{\\pi}"},{"id":"L_belt","formula":"2 * C + 3.14159 / 2 * (d1 + d2) + ((d2 - d1)^2) / (4 * C)","description":"Required belt length","latex":"L = 2C + \\frac{\\pi}{2}(d_1 + d_2) + \\frac{(d_2 - d_1)^2}{4C}"},{"id":"z_belt","formula":"round(L_belt / pitch)","description":"Belt teeth count (rounded to standard)","latex":"z_{belt} = \\frac{L}{p}"},{"id":"v_belt","formula":"(d1 * 3.14159 * n1) / 60000","description":"Belt linear velocity (m/s)","latex":"v = \\frac{\\pi \\cdot d_1 \\cdot n_1}{60000}"},{"id":"F_t","formula":"(P_design * 1000) / v_belt","description":"Tangential belt force (effective pull)","latex":"F_t = \\frac{P_{design} \\times 1000}{v}"}],"outputs":["i","T1","z1","z2","d1","d2","L_belt","z_belt","v_belt","F_t","P_design"]},{"id":"torque_calculation","name":"Torque from Power & Speed","category":"mechanical","description":"Calculate shaft torque from motor power and rotational speed. Fundamental first step in any drivetrain design.","inputs":[{"key":"P","type":"number","unit":"kW","description":"Motor Power","default":10},{"key":"n","type":"number","unit":"rpm","description":"Rotational Speed","default":1500}],"steps":[{"id":"T","formula":"(9550 * P) / n","description":"Torque from power and speed (ISO standard)","latex":"T = \\frac{9550 \\times P}{n}"},{"id":"omega","formula":"(2 * 3.14159 * n) / 60","description":"Angular velocity","latex":"\\omega = \\frac{2\\pi n}{60}"}],"outputs":["T","omega"]}]}